<?xml version="1.0" encoding="utf-8"?><!-- 首页保留右上角地点切换入口，主体按 HomeUiState 展示启动进度、原因空态或天气。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_background"
    android:orientation="vertical"
    android:paddingHorizontal="16dp">

    <!-- 切换入口始终可见，加载和空态时也可以选择其他地点。 -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/home_change_location"
        style="@style/Widget.AppCompat.Button.Borderless"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="end"
        android:layout_marginBottom="8dp"
        android:contentDescription="@string/change_location"
        android:minWidth="64dp"
        android:text="@string/switch_location"
        android:textAllCaps="false"
        android:textColor="?attr/colorPrimary"
        android:textSize="15sp" />

    <com.example.skymoment.common.WeatherLoadingView
        android:id="@+id/home_startup"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.example.skymoment.common.WeatherEmptyView
        android:id="@+id/home_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/home_weather"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />
</LinearLayout>
