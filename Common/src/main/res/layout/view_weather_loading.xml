<?xml version="1.0" encoding="utf-8"?>
<!-- 启动加载视图，按真实定位与天气请求阶段更新文案和进度。 -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="32dp"
        android:paddingEnd="16dp"
        android:paddingBottom="80dp">

        <ImageView
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_weather_loading" />

        <TextView
            android:id="@+id/loading_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:saveEnabled="false"
            android:text="@string/locating"
            android:textColor="@color/home_text"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/loading_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingExtra="5dp"
            android:saveEnabled="false"
            android:text="@string/startup_location_message"
            android:textColor="@color/home_secondary"
            android:textSize="14sp" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/loading_progress"
            android:layout_width="112dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:importantForAccessibility="no"
            android:indeterminate="true"
            app:indicatorColor="?attr/colorPrimary"
            app:trackColor="#E0E3EF"
            app:trackCornerRadius="2dp"
            app:trackThickness="3dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:importantForAccessibility="noHideDescendants"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/loading_location_step"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/startup_step_background"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp"
                android:saveEnabled="false"
                android:text="@string/startup_location_step"
                android:textColor="@color/startup_step_text"
                android:textSize="12sp" />

            <View
                android:layout_width="24dp"
                android:layout_height="1dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="#DADDE8" />

            <TextView
                android:id="@+id/loading_weather_step"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/startup_step_background"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp"
                android:saveEnabled="false"
                android:text="@string/startup_weather_step"
                android:textColor="@color/startup_step_text"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
